# ID del documento publicado: la parte de la URL de "Publicar en la web"
# entre /d/e/ y /pub (empieza por 2PACX-)
GOOGLE_SHEETS_PUBLISHED_ID=

# gid del tab de palabras: valor de gid= en la URL del editor con ese tab
# abierto (también visible en la URL publicada de ese tab)
GOOGLE_SHEETS_WORDS_GID=

# gid del tab de categorías
GOOGLE_SHEETS_CATEGORIES_GID=
